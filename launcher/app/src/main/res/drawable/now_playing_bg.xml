<?xml version="1.0" encoding="utf-8"?>
<!-- The card's info part: invisible until focused, then a soft lighter wash. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#2EFFFFFF" /><corners android:radius="16dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="16dp" /></shape></item>
</selector>
