<?xml version="1.0" encoding="utf-8"?>
<!-- Artwork frame: invisible until focused, then a white ring around the cover, tvOS style. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><stroke android:width="3dp" android:color="#F5FFFFFF" /><corners android:radius="20dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="20dp" /></shape></item>
</selector>
